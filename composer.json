{
    "name": "joomla/language",
    "type": "joomla-package",
    "description": "Joomla Language Package",
    "keywords": ["joomla", "framework", "language"],
    "homepage": "https://github.com/joomla-framework/language",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0",
        "ext-xml": "*",
        "joomla/string": "^4.0",
        "symfony/deprecation-contracts": "^2|^3"
    },
    "require-dev": {
        "joomla/di": "^4.0",
        "joomla/registry": "^4.0",
        "joomla/test": "^4.0",
        "phpunit/phpunit": "^12.2.6",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-deprecation-rules": "^2.0.3"
    },
    "suggest": {
        "joomla/di": "To use the Language ServiceProviderInterface objects, install joomla/di."
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Language\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Language\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev"
}
